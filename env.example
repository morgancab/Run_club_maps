# Variables d'environnement pour le déploiement Vercel et le développement local
#
# Pour le développement local : copier ce fichier vers .env (jamais commit,
# voir .gitignore) et remplir les vraies valeurs.

# ========================================
# SUPABASE — SOURCE DE DONNÉES ACTUELLE DU SITE
# ========================================
#
# Le site lit désormais la liste des clubs depuis une table Supabase
# ("clubs") plutôt que depuis le Google Sheet. Voir supabase/schema.sql pour
# créer la table, et scripts/migrate-sheet-to-supabase.ts pour y importer les
# données existantes du Sheet.
#
# Pour obtenir ces valeurs :
# 1. Créer un projet sur https://supabase.com (offre gratuite suffisante)
# 2. Project Settings > Data API : copier "Project URL" -> SUPABASE_URL
# 3. Project Settings > API Keys : copier la clé "anon public" -> SUPABASE_ANON_KEY
#    et la clé "service_role" -> SUPABASE_SERVICE_ROLE_KEY

# URL du projet Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Clé publique "anon" — utilisée par le site pour LIRE les clubs (lecture
# seule côté serveur de l'API, jamais exposée directement au navigateur ici).
SUPABASE_ANON_KEY=

# Clé "service_role" — contourne la sécurité au niveau des lignes (RLS).
# ⚠️ Ne JAMAIS l'exposer côté client ni la commit. Utilisée par les scripts
# de migration EN LOCAL, et aussi par deux routes serveur en production :
# api/submit-club (formulaire "Proposer un club") et implicitement par
# api/geocode. Elle ne quitte jamais le serveur : le navigateur ne la voit
# jamais, seul le code qui tourne côté Vercel/Node la lit.
SUPABASE_SERVICE_ROLE_KEY=

# ========================================
# GOOGLE SHEETS API — UTILISÉ UNIQUEMENT PAR LA MIGRATION
# ========================================
#
# Ces variables ne servent plus au site en fonctionnement normal : elles ne
# sont nécessaires que pour relancer scripts/migrate-sheet-to-supabase.ts
# (ré-importer le Sheet vers Supabase). Si vous ne migrez plus depuis le
# Sheet, vous pouvez les laisser vides.

# Clé de service Google (contenu JSON complet)
# ⚠️ IMPORTANT: Copier TOUT le contenu du fichier JSON, y compris les accolades {}
#
# Pour obtenir cette clé :
# 1. Aller sur Google Cloud Console (https://console.cloud.google.com/)
# 2. Créer un projet ou sélectionner un projet existant
# 3. Activer l'API Google Sheets
# 4. Créer un compte de service (IAM & Admin > Comptes de service)
# 5. Télécharger la clé JSON
# 6. Copier TOUT le contenu JSON dans cette variable
#
# Format attendu (exemple):
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"votre-projet","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"votre-service@votre-projet.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ========================================
# ÉTAPES DE CONFIGURATION VERCEL
# ========================================

# 1. Dans Vercel Dashboard > Settings > Environment Variables
# 2. Ajouter SUPABASE_URL, SUPABASE_ANON_KEY ET SUPABASE_SERVICE_ROLE_KEY
#    (Production, Preview, Development) — les trois sont désormais
#    nécessaires en production à cause du formulaire "Proposer un club"
#    (api/submit-club), qui doit écrire dans Supabase depuis le serveur.
# 3. Sauvegarder et redéployer

# ========================================
# TEST DE CONFIGURATION
# ========================================

# Pour importer/ré-importer les données du Sheet vers Supabase :
# npm run migrate:supabase

# Pour tester l'API en local (une fois Supabase configuré) :
# npm run test:api
